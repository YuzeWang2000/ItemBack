# PostgreSQL
POSTGRES_DB=itemback
POSTGRES_USER=itemback
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://itemback:change-this-database-password@localhost:5432/itemback?schema=public

# Single-user initialization. The API creates this account if it does not exist.
ADMIN_EMAIL=admin@itemback.local
ADMIN_PASSWORD=change-this-password

# API and browser client
PORT=3000
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
VITE_API_URL=/api/v1
NODE_ENV=development
SESSION_DAYS=30

# Private local attachment storage (relative paths are resolved from apps/api)
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=25
