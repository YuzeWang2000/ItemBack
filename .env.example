# PostgreSQL
POSTGRES_DB=itemback
POSTGRES_USER=itemback
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://itemback:change-this-database-password@localhost:5432/itemback?schema=public

# Single-user initialization. The API creates this account if it does not exist.
ADMIN_EMAIL=admin@itemback.local
ADMIN_PASSWORD=change-this-password

# API and browser client
PORT=3000
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
VITE_API_URL=/api/v1
NODE_ENV=development
SESSION_DAYS=30

# Private local attachment storage (relative paths are resolved from apps/api)
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=25

# macOS local background removal. Native API development defaults to command mode and the
# Swift release binary under native/background-removal-helper. Docker production should use
# http mode with the helper running on the Mac host and the same 32+ character token.
VISION_HELPER_MODE=command
# VISION_HELPER_PATH=../../native/background-removal-helper/.build/release/itemback-vision-helper
# VISION_HELPER_URL=http://host.docker.internal:43118/remove-background
# VISION_HELPER_TOKEN=replace-with-a-random-secret-at-least-32-characters
VISION_MAX_OUTPUT_MB=40
