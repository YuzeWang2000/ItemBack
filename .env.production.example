# PostgreSQL container. Keep POSTGRES_PASSWORD and the URL-encoded password in
# DATABASE_URL in sync. DATABASE_URL must use the Compose service name `postgres`.
POSTGRES_DB=itemback
POSTGRES_USER=itemback
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
DATABASE_URL=postgresql://itemback:replace-with-a-long-url-safe-password@postgres:5432/itemback?schema=public

# Absolute host path. PostgreSQL files and attachments remain here even if
# containers or Docker Desktop are removed. Back up this directory separately.
ITEMBACK_DATA_DIR=/absolute/path/to/itemback-data

# Single-user initialization
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-another-long-password

# Public HTTPS origin serving the Web application
WEB_ORIGIN=https://itemback.example.com
WEB_PORT=80
COOKIE_SECURE=true
SESSION_DAYS=30
MAX_FILE_SIZE_MB=25

# macOS 宿主机本地抠图助手；密钥必须与 ITEMBACK_VISION_TOKEN 相同
VISION_HELPER_MODE=http
VISION_HELPER_URL=http://host.docker.internal:43118/remove-background
VISION_HELPER_TOKEN=replace-with-a-random-secret-at-least-32-characters
VISION_MAX_OUTPUT_MB=40
