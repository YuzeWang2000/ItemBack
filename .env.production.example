# PostgreSQL container. Keep POSTGRES_PASSWORD and the URL-encoded password in
# DATABASE_URL in sync. DATABASE_URL must use the Compose service name `postgres`.
POSTGRES_DB=itemback
POSTGRES_USER=itemback
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
DATABASE_URL=postgresql://itemback:replace-with-a-long-url-safe-password@postgres:5432/itemback?schema=public

# Single-user initialization
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-another-long-password

# Public HTTPS origin serving the Web application
WEB_ORIGIN=https://itemback.example.com
SESSION_DAYS=30
MAX_FILE_SIZE_MB=25
