{
  "name": "itemback",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @itemback/api dev\" \"pnpm --filter @itemback/web dev\"",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "pnpm -r --if-present test",
    "test:integration": "node scripts/run-integration.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "build": "pnpm -r --if-present build",
    "verify": "pnpm docs:check && pnpm lint && pnpm test && pnpm build && pnpm test:integration && pnpm test:e2e",
    "db:generate": "pnpm --filter @itemback/api prisma:generate",
    "db:migrate": "node scripts/run-db-command.mjs prisma:migrate",
    "db:seed": "node scripts/run-db-command.mjs prisma:seed",
    "db:reset": "node scripts/run-db-command.mjs prisma:reset",
    "prod:init": "bash scripts/prod-init.sh",
    "prod:start": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d",
    "prod:stop": "docker compose --env-file .env.production -f docker-compose.prod.yml down",
    "prod:update": "bash scripts/prod-update.sh",
    "prod:status": "docker compose --env-file .env.production -f docker-compose.prod.yml ps",
    "prod:logs": "docker compose --env-file .env.production -f docker-compose.prod.yml logs --tail=100",
    "prod:backup": "bash scripts/prod-backup.sh",
    "prod:reset": "bash scripts/prod-reset.sh",
    "vision:build": "bash scripts/build-vision-helper.sh",
    "vision:serve": "bash scripts/run-vision-helper.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.1",
    "embedded-postgres": "18.1.0-beta.15",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
